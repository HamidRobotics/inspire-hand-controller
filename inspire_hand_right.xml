<?xml version="1.0"?>
<!-- Inspire Hand RH56DFTP RIGHT — Improved MJCF
     Generated from urdf_right_with_force_sensor.urdf
     DOF convention: 1000=Open(joint@0), 0=Closed(joint@max)
     Meshes: place all STL files in meshes/ subfolder
-->
<mujoco model="inspire_hand_right">

  <compiler angle="radian" meshdir="meshes" eulerseq="XYZ"/>

  <option gravity="0 0 -9.81" timestep="0.001" iterations="50" solver="Newton"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>
    <rgba haze="0.05 0.05 0.08 1"/>
    <quality shadowsize="2048"/>
    <map shadowclip="0.1" shadowscale="0.5"/>
    <global offwidth="2560" offheight="1920"/>

  </visual>

  <default>
    <joint damping="0.05" armature="0.001" frictionloss="0.01"/>
    <position kp="20" kv="2" forcelimited="true" forcerange="-5 5"/>
  </default>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.10 0.12 0.16"
              rgb2="0.02 0.02 0.04" width="256" height="256"/>
    <mesh name="base_link_mesh" file="right_base_link.STL"/>
    <mesh name="index_force_sensor_pad_mesh" file="index_force_sensor_pad.STL"/>
